{
  "name": "n8n-nodes-dompruner",
  "version": "0.1.0",
  "description": "n8n node that refines HTML to LLM-ready Markdown via DomPruner (90%+ token reduction)",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "dompruner",
    "html",
    "markdown",
    "llm",
    "token-reduction"
  ],
  "main": "index.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/DomPruner/DomPruner.node.js"
    ]
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch"
  },
  "files": [
    "dist",
    "index.js"
  ],
  "devDependencies": {
    "n8n-workflow": "*",
    "typescript": "^5.0.0"
  }
}
